BACKUP ~Sharteel_BG2/shartel-backup~
AUTHOR ~Nicolas Peters - darthsabe@web.de~

README ~Sharteel_BG2\Readme\Liesmich.txt~

BEGIN ~Shar-Teel Mod für Baldur's Gate II~

OUTER_SPRINT "sharL" "sharL"
OUTER_SPRINT "sharS" "sharS"

			OUTER_SET Sharteel_portrait = 1

	INCLUDE ~Sharteel_BG2/Lib/Sharteel_BG2.tpa~

BEGIN ~Shar-Teels neue Portraits mit den alten (BG1) ersetzen?~ // Remplacer les nouveaux portraits de Shar-Teel par les anciens (BG1) ?

			OUTER_SET Sharteel_portrait = 0

OUTER_SPRINT "sharL" "SHARTELL"
OUTER_SPRINT "sharS" "SHARTELM"

	INCLUDE ~Sharteel_BG2/Lib/Sharteel_BG2.tpa~
