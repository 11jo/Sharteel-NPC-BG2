BACKUP ~weidu_external/Sharteel_BG2/backup~
AUTHOR ~Nicolas Peters - darthsabe@web.de~

README ~Sharteel_BG2\Readme\Liesmich.txt~

ALWAYS

	DEFINE_ACTION_FUNCTION autotra_workaround BEGIN
	COPY ~Sharteel_BG2/Languages/German~				~weidu_external/Sharteel_BG2/Languages/autotra/%LANGUAGE%~
	COPY ~Sharteel_BG2/Languages/%LANGUAGE%~				~weidu_external/Sharteel_BG2/Languages/autotra/%LANGUAGE%~
	END

	LAF autotra_workaround END

	ACTION_IF GAME_IS ~tob bgt~ BEGIN

//			ACTION_DEFINE_ARRAY Shar_noconvert BEGIN END

		ACTION_DEFINE_ARRAY Shar_reload BEGIN Setup END
			LAF HANDLE_CHARSETS
				INT_VAR
				infer_charsets = 1
				from_utf8      = 1
				STR_VAR
				tra_path = EVAL ~weidu_external/Sharteel_BG2/Languages/autotra~
				out_path = EVAL ~weidu_external/Sharteel_BG2/Languages/autotra~
				iconv_path = ~Sharteel_BG2/Languages/autotra/iconv~
//				noconvert_array = Shar_noconvert
				reload_array = Shar_reload
			END

	END // GAME_IS ~tob bgt~

END // ALWAYS

AUTO_TRA ~weidu_external/Sharteel_BG2/Languages/autotra/%s~

LANGUAGE ~German~
         ~german~
         ~Sharteel_BG2/Languages/german/setup.tra~

LANGUAGE ~Francais~
         ~french~
         ~Sharteel_BG2/Languages/french/setup.tra~

BEGIN @0 /* Neue Portraits für Shar-Teel ? */
DESIGNATED 0
SUBCOMPONENT @1 /* Shar-Teel Mod für Baldur's Gate II */
LABEL ~Nicolas-Peters_Sharteel_BG2_Neue~
REQUIRE_PREDICATE (GAME_IS ~tob bgt bg2ee eet~) @30 /* Necessite BG2-ToB / BG2EE / BGT / EET */

OUTER_SPRINT "sharL" ~JOsharL~
OUTER_SPRINT "sharS" ~JOsharS~

			OUTER_SET Sharteel_portrait = 1

	INCLUDE ~Sharteel_BG2/Lib/Sharteel_BG2.tpa~

BEGIN @4 /* BG1 Portraits für Shar-Teel ? */ // Remplacer les nouveaux portraits de Shar-Teel par les anciens (BG1) ?
DESIGNATED 1
SUBCOMPONENT @1 /* Shar-Teel Mod für Baldur's Gate II */
LABEL ~Nicolas-Peters_Sharteel_BG2_Portraits~
REQUIRE_PREDICATE (GAME_IS ~tob bgt bg2ee eet~) @30 /* Necessite BG2-ToB / BG2EE / BGT / EET */

			OUTER_SET Sharteel_portrait = 0

OUTER_SPRINT "sharL"~SHARTELL~
OUTER_SPRINT "sharS" ~SHARTELM~

	INCLUDE ~Sharteel_BG2/Lib/Sharteel_BG2.tpa~
